{
  "name": "@foundryvtt/vite-plugin",
  "version": "0.1.0",
  "description": "FoundryVTT plugin for Vite",
  "license": "MIT",
  "keywords": [
    "foundryvtt",
    "vite",
    "vite-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch src",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.6.0",
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "dependencies": {
    "@foundryvtt/vite-plugin-copy-static-files": "github:TheSmeltingAnvil/fvtt-vite-plugins#main&path:/packages/vite-plugin-copy-static-files",
    "@foundryvtt/vite-plugin-create-file": "github:TheSmeltingAnvil/fvtt-vite-plugins#main&path:/packages/vite-plugin-create-file",
    "@foundryvtt/vite-plugin-import-files": "github:TheSmeltingAnvil/fvtt-vite-plugins#main&path:/packages/vite-plugin-import-files",
    "@foundryvtt/vite-plugin-replace-vars": "github:TheSmeltingAnvil/fvtt-vite-plugins#main&path:/packages/vite-plugin-replace-vars",
    "@rollup/pluginutils": "5.1.4",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.15.23",
    "@types/throttle-debounce": "^5.0.2",
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "js-yaml": "4.1.0",
    "picocolors": "^1.1.1",
    "throttle-debounce": "^5.0.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
